{
  "name": "@todo/account-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
"scripts": {
  "build": "tsc -p tsconfig.build.json",
  "start": "node dist/server.js",
  "dev": "tsx watch src/server.ts",
  "test": "vitest run --config vitest.config.ts",
  "migrate": "node-pg-migrate up -m migrations",
  "start:outbox": "node dist/worker/outbox-publisher.worker.js",
  "start:cleanup": "node dist/retention/cleanup.worker.js",
  "migrate:down": "node-pg-migrate down -m migrations",
  "migrate:create": "node-pg-migrate create -m migrations",
  "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
  "start:notification-consumer": "node dist/worker/notification.worker.js"
  ,"start:owner-projection-rebuild": "node dist/maintenance/owner-projection-rebuild.worker.js"
},
  "dependencies": {
    "@todo/common": "*",
    "@todo/contracts": "*",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "node-pg-migrate": "^8.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}
