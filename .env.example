# PostgreSQL owned by Account Service
ACCOUNT_POSTGRES_USER=account_user
ACCOUNT_POSTGRES_PASSWORD=change-this-local-password
ACCOUNT_POSTGRES_DB=account_db
ACCOUNT_POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

# RabbitMQ
RABBITMQ_USER=todo_user
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672



# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API Gateway
API_PORT=3000
LOG_LEVEL=info


# Account Service
ACCOUNT_SERVICE_PORT=3001
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=2000