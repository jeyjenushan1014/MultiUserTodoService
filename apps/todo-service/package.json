{
  "name": "@todo/todo-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/src/blockchain/generated', { recursive: true }); for (const f of ['task-history.abi.json', 'task-history.deployment.json']) { if (fs.existsSync('src/blockchain/generated/' + f)) fs.copyFileSync('src/blockchain/generated/' + f, 'dist/src/blockchain/generated/' + f); } })\"",
    "start": "node dist/src/server.js",
    "start:owner-consumer": "node dist/src/workers/owner-projection.worker.js",
    "test": "vitest run --config vitest.config.ts",
    "migrate": "node-pg-migrate up -m migrations --migrations-table pgmigrations",
    "migrate:down": "node-pg-migrate down -m migrations --migrations-table pgmigrations",
    "start:history-worker": "node dist/src/history/history-worker.js",
    "replay:event": "node scripts/replay-event.mjs",
    "ops:progress": "node scripts/progress-status.mjs",
    "start:cleanup": "node dist/src/retention/cleanup.worker.js",
    "start:chain-indexer": "node dist/src/blockchain/task-history-indexer.worker.js",
    "start:chain-writer": "node dist/src/blockchain/chain-submission.worker.js",
     "rebuild:chain-projection": "node dist/src/blockchain/rebuild-task-history-projection.js"
  },
  "dependencies": {
    "@todo/common": "1.0.0",
    "@todo/contracts": "1.0.0",
    "amqplib": "^2.0.1",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  }
}
