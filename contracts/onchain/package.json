{
  "name": "onchain",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "hardhat build && npm run abi:export",
    "abi:export": "node scripts/export-abi.mjs",
    "test": "hardhat test",
    "test:gas": "hardhat test nodejs --gas-stats --gas-stats-json gas-stats.json",
    "deploy:local": "hardhat ignition deploy ignition/modules/TaskHistory.ts",
    "deploy:localhost": "hardhat ignition deploy ignition/modules/TaskHistory.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.4",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.0",
    "typescript": "~6.0.3",
    "viem": "^2.57.1"
  }
}
